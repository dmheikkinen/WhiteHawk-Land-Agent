# Ohio Landman Pipeline — environment variables
# ─────────────────────────────────────────────
# SETUP:
#   cp .env.example .env
#   Then fill in your real values in .env.
#
# SECURITY:
#   .env is listed in .gitignore — never commit it.
#   On a server, prefer systemd EnvironmentFile or Docker --env-file
#   over storing .env in the repo directory.


# ── REQUIRED ──────────────────────────────────────────────────────────────────

# OpenAI API key — used by Phase 2 (Score) and Phase 3 (Orchestrate).
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-REPLACE_ME

# SerpAPI key — used by Phase 1 (Harvest) for Google web search.
# Get yours at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=REPLACE_ME


# ── OPTIONAL: Phase 3 Assistant ───────────────────────────────────────────────

# OpenAI Assistant ID for the Phase 3 Orchestrator.
# Defaults to the bundled assistant; override if you create your own.
# ASSISTANT_ID=asst_EFzDaNzm7hT8bz1InWgAhwbT

# How many contacts to request from the Phase 3 Orchestrator (default: 50).
# TARGET_CONTACTS=50


# ── OPTIONAL: Phase 2 Scoring tuning ─────────────────────────────────────────

# OpenAI model used for batch scoring (default: gpt-4o-mini).
# Options: gpt-4o-mini  gpt-4o  gpt-4.1-mini  gpt-4.1
# SCORE_MODEL=gpt-4o-mini

# Candidates sent per AI call, hard-capped at 20 (default: 15).
# BATCH_SIZE=15

# Drop contacts with relevance_score below this threshold (default: 4.0).
# MIN_SCORE=4.0

# Truncate evidence snippets to this many characters before sending (default: 300).
# MAX_SNIPPET_CHARS=300


# ── OPTIONAL: Run-mode flags ──────────────────────────────────────────────────

# Conservative Mode — halves search results per query, enforces ≥2.5 s SerpAPI
# delay, and shortens snippets to 150 chars.  Good for staying inside free-tier
# SerpAPI limits.  Set to 1 to enable.
# CONSERVATIVE_MODE=0

# Dry Run — validates config and prints a batch/query plan without making any
# API calls.  Useful for a quick sanity check before a full run.  Set to 1.
# DRY_RUN=0


# ── OPTIONAL: Output path overrides ──────────────────────────────────────────

# Override where harvest_contacts.py writes its raw output files.
# These default to ./data/ when the server launches the scripts.
# RAW_HITS_FILE=data/raw_hits.jsonl
# CANDIDATES_FILE=data/candidates.csv

# Override the scored contacts output filename (default: timestamped).
# OUTPUT_FILE=data/ohio_landman_contacts_custom.csv
